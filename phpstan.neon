includes:
    - ./phpstan-baseline.neon
    - ./vendor/larastan/larastan/extension.neon
    - ./vendor/phpstan/phpstan/conf/bleedingEdge.neon
parameters:
    level: 4
    paths:
        - src
    excludePaths:
        # Livewire and Flux are not installed in the SDK, apps that use these pages test them
        - src/Webhook/Outbound/Livewire
    tmpDir: .tmp/phpstan
